{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "prCreation": "immediate",
  "lockFileMaintenance": {
    "enabled": true
  },
  "enabledManagers": [
    "pep621",
    "dockerfile",
    "npm",
    "mise",
    "custom.regex",
    "github-actions"
  ],
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "5 days",
  "internalChecksFilter": "strict",
  "addLabels": [
    "dependencies"
  ],
  "customManagers": [
    {
      "description": "Versions marked with a `# renovate:` comment on the line above (docker/Dockerfile, the setup-tools action)",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/",
        "/^\\.github/actions/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n[^\\n]*?(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "One PR for all GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Auto-merge non-major GitHub Actions updates and digest pins",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Always create lockfile maintenance PRs without dashboard approval",
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "dependencyDashboardApproval": false
    },
    {
      "matchManagers": [
        "pep621"
      ],
      "rangeStrategy": "pin"
    },
    {
      "description": "Auto-merge patch and minor Python dependency updates",
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Auto-merge Docker digest and patch updates",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Auto-merge patch and minor toolchain updates (mise.toml and the pins grouped with it below)",
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "requires-python moves with the Python group by hand (see below), not on its own",
      "matchPackageNames": [
        "python"
      ],
      "matchManagers": [
        "pep621"
      ],
      "enabled": false
    },
    {
      "description": "One PR per Python version across mise.toml, the dev container, and the production image",
      "matchDepNames": [
        "python",
        "mcr.microsoft.com/devcontainers/python"
      ],
      "matchManagers": [
        "mise",
        "dockerfile"
      ],
      "groupName": "python"
    },
    {
      "description": "Python minor and major upgrades wait for dashboard approval and merge by hand: they also need requires-python, mypy python_version, and ruff target-version in pyproject.toml updated",
      "matchDepNames": [
        "python",
        "mcr.microsoft.com/devcontainers/python"
      ],
      "matchManagers": [
        "mise",
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "One PR per Node version across mise.toml and the production image",
      "matchDepNames": [
        "node"
      ],
      "matchManagers": [
        "mise",
        "dockerfile"
      ],
      "groupName": "node"
    },
    {
      "description": "One PR per pnpm version across mise.toml, frontend/package.json (packageManager and devEngines), and the production image. Exempt from the npm dashboard approval so the pins stay in step.",
      "matchDepNames": [
        "pnpm"
      ],
      "groupName": "pnpm",
      "dependencyDashboardApproval": false
    },
    {
      "description": "Auto-merge patch and minor pnpm updates, including the package.json packageManager pin the npm manager owns",
      "matchDepNames": [
        "pnpm"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "One PR per uv version across mise.toml and the production image",
      "matchDepNames": [
        "uv"
      ],
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "groupName": "uv"
    },
    {
      "description": "One PR per mise version across the dev container and the CI setup-tools action",
      "matchDepNames": [
        "jdx/mise",
        "jdxcode/mise"
      ],
      "groupName": "mise",
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ]
    }
  ]
}
